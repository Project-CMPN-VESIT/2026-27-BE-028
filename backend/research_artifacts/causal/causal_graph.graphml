  <data key="d0">Combined hard-body sphere collision cross-section</data>
</edge>
<edge source="deltav_required" target="feasibility_flag">
  <data key="d0">Hard physical law: feasibility_flag = 1 iff deltav_required &lt;= max_delta_v</data>
</edge>
<edge source="deltav_required" target="fuel_margin">
  <data key="d0">Fuel margin depletes with required delta-V</data>
</edge>
<edge source="deltav_required" target="cost_of_acting">
  <data key="d0">Act cost scales with fuel depletion and propellant expenditure</data>
</edge>
<edge source="time_to_TCA" target="deltav_required">
  <data key="d0">Delta-V required scales inversely with lead time before TCA: delta_r = delta_v * delta_t</data>
</edge>
<edge source="time_to_TCA" target="maneuver_window_remaining">
  <data key="d0">Maneuver window strictly bounded by time remaining to TCA</data>
</edge>
<edge source="time_to_TCA" target="cost_of_waiting">
  <data key="d0">Waiting cost increases as decision horizon shrinks</data>
</edge>
<edge source="feasibility_flag" target="commit_decision">
  <data key="d0">Hard constraint: Infeasible state forces WAIT</data>
</edge>
<edge source="max_delta_v" target="feasibility_flag">
  <data key="d0">Spacecraft thruster velocity capacity limit</data>
</edge>
<edge source="fuel_remaining" target="fuel_margin">
  <data key="d0">Available propellant mass bounds remaining margin</data>
</edge>
<edge source="cost_of_waiting" target="commit_decision">
  <data key="d0">Commit triggered when waiting risk exceeds maneuver cost</data>
</edge>
<edge source="cost_of_acting" target="commit_decision">
  <data key="d0">Commit triggered when waiting risk exceeds maneuver cost</data>
