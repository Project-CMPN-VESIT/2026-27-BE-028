<edge source="semi_major_axis" target="relative_distance">
  <data key="d0">Orbital geometry defines encounter trajectory</data>
</edge>
<edge source="relative_distance" target="relative_closing_rate">
  <data key="d0">Kinematic rate of change</data>
</edge>
<edge source="relative_distance" target="poc">
  <data key="d0">Distance to conjunction center directly scales collision probability</data>
</edge>
<edge source="relative_distance" target="deltav_required">
  <data key="d0">Required impulsive delta-V scales with miss distance deficit</data>
</edge>
<edge source="eccentricity" target="relative_distance">
  <data key="d0">Orbital geometry defines encounter trajectory</data>
</edge>
<edge source="inclination" target="relative_closing_rate">
  <data key="d0">Inclination difference determines encounter geometry</data>
</edge>
<edge source="relative_closing_rate" target="deltav_required">
  <data key="d0">Encounter velocity dictates required orbital impulse</data>
</edge>
<edge source="measurement_noise" target="combined_covariance_magnitude">
  <data key="d0">Sensor noise inflates positional uncertainty</data>
</edge>
<edge source="combined_covariance_magnitude" target="poc">
  <data key="d0">Foster / NASA 2D/3D collision integral over covariance ellipsoid</data>
</edge>
<edge source="tracking_reliability_index" target="combined_covariance_magnitude">
  <data key="d0">Tracking quality bounds covariance growth</data>
</edge>
