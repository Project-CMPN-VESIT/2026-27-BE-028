<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd"><key id="d0" for="edge" attr.name="reason" attr.type="string"/>
<graph edgedefault="directed"><node id="semi_major_axis"/>
<node id="relative_distance"/>
<node id="eccentricity"/>
<node id="inclination"/>
