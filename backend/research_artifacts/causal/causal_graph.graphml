<node id="deltav_required"/>
<node id="time_to_TCA"/>
<node id="feasibility_flag"/>
<node id="max_delta_v"/>
<node id="fuel_margin"/>
<node id="fuel_remaining"/>
<node id="maneuver_window_remaining"/>
<node id="cost_of_waiting"/>
<node id="cost_of_acting"/>
