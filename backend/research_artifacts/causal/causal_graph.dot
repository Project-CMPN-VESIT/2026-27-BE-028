combined_covariance_magnitude -> poc [reason="Foster / NASA 2D/3D collision integral over covariance ellipsoid"];
tracking_reliability_index -> combined_covariance_magnitude [reason="Tracking quality bounds covariance growth"];
solar_activity -> combined_covariance_magnitude [reason="Atmospheric drag disturbance induces orbital error"];
drag_level -> combined_covariance_magnitude [reason="Atmospheric drag disturbance induces orbital error"];
poc -> cost_of_waiting [reason="Risk cost of waiting is a monotonic function of collision probability"];
hard_body_radius -> poc [reason="Combined hard-body sphere collision cross-section"];
deltav_required -> feasibility_flag [reason="Hard physical law: feasibility_flag = 1 iff deltav_required <= max_delta_v"];
deltav_required -> fuel_margin [reason="Fuel margin depletes with required delta-V"];
deltav_required -> cost_of_acting [reason="Act cost scales with fuel depletion and propellant expenditure"];
time_to_TCA -> deltav_required [reason="Delta-V required scales inversely with lead time before TCA: delta_r = delta_v * delta_t"];
time_to_TCA -> maneuver_window_remaining [reason="Maneuver window strictly bounded by time remaining to TCA"];
time_to_TCA -> cost_of_waiting [reason="Waiting cost increases as decision horizon shrinks"];
feasibility_flag -> commit_decision [reason="Hard constraint: Infeasible state forces WAIT"];
max_delta_v -> feasibility_flag [reason="Spacecraft thruster velocity capacity limit"];
fuel_remaining -> fuel_margin [reason="Available propellant mass bounds remaining margin"];
cost_of_waiting -> commit_decision [reason="Commit triggered when waiting risk exceeds maneuver cost"];
cost_of_acting -> commit_decision [reason="Commit triggered when waiting risk exceeds maneuver cost"];
