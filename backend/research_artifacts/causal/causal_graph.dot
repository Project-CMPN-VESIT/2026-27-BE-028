semi_major_axis -> relative_distance [reason="Orbital geometry defines encounter trajectory"];
relative_distance -> relative_closing_rate [reason="Kinematic rate of change"];
relative_distance -> poc [reason="Distance to conjunction center directly scales collision probability"];
relative_distance -> deltav_required [reason="Required impulsive delta-V scales with miss distance deficit"];
